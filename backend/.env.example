APP_NAME=TaskFlow
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-laravel-api.onrender.com

# Frontend URL (used for CORS and Sanctum stateful domains)
# For multiple origins use comma-separated: https://app.vercel.app,https://custom-domain.com
FRONTEND_URL=https://your-frontend.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -------------------------------------------------------
# Database — Managed MySQL (Render, PlanetScale, Railway)
# -------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=your-db-host.render.com
DB_PORT=3306
DB_DATABASE=taskflow_production
DB_USERNAME=taskflow_user
DB_PASSWORD=

# Only needed if your managed MySQL provider requires SSL (PlanetScale, Aiven, etc.)
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# -------------------------------------------------------
# Sanctum
# -------------------------------------------------------
# Comma-separated list of frontend domains that can use cookie auth.
# For pure Bearer token auth (this app's approach) this can stay as the frontend host.
SANCTUM_STATEFUL_DOMAINS=your-frontend.vercel.app

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# -------------------------------------------------------
# File Storage
# -------------------------------------------------------
# Options: local (ephemeral - NOT for production), s3 (AWS S3, Cloudflare R2, Backblaze B2)
FILESYSTEM_DISK=s3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=taskflow-attachments
# AWS_ENDPOINT=              # Only needed for S3-compatible APIs (Cloudflare R2, Backblaze B2, MinIO)
# AWS_USE_PATH_STYLE_ENDPOINT=false

# -------------------------------------------------------
# Cache & Queue
# -------------------------------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log

# -------------------------------------------------------
# Mail (optional — only needed for email notifications)
# -------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# -------------------------------------------------------
# Redis (optional — only if you switch to Redis cache/queue)
# -------------------------------------------------------
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

VITE_APP_NAME="${APP_NAME}"
