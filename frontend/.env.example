# -------------------------------------------------------
# TaskFlow Frontend Environment Variables
# -------------------------------------------------------
# Copy this file to .env for local development.
# In Vercel, set these in Project Settings → Environment Variables.
#
# IMPORTANT: Every variable prefixed VITE_ is EXPOSED to the browser.
# NEVER put secrets, database passwords, or private API keys here.
# -------------------------------------------------------

# Backend Laravel API base URL (must include /api)
# Development:  http://localhost:8000/api
# Production:   https://your-laravel-api.onrender.com/api
VITE_API_URL=https://your-laravel-api.onrender.com/api
